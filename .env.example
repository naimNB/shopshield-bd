# ==============================================================================
# ShopShield BD — Environment Configuration Template
# YUNet AIgnite Buildathon 2026
# Copy this file to .env and fill in the necessary values. Never commit .env.
# ==============================================================================

# Application Settings
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="ShopShield BD"
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# Security
SECRET_KEY=replace_with_a_secure_random_string_in_production
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Database (Future Phase)
DATABASE_URL=sqlite+aiosqlite:///./shopshield.db

# Multimodal AI Engine (Planned for Task 02+)
# Obtain key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# E-Commerce & Verification Integrations (Future Phase)
# Courier Tracking APIs (e.g., Steadfast, Pathao, RedX)
COURIER_API_ENDPOINT=https://api.courier-sandbox.example.com
COURIER_API_KEY=

# Mobile Financial Services (MFS) Sandbox (bKash / Nagad verification signals)
MFS_VERIFICATION_ENABLED=false
BKASH_MERCHANT_QUERY_URL=
