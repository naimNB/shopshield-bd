# ==============================================================================
# ShopShield BD — Environment Configuration Template
# YUNet AIgnite Buildathon 2026
# Copy this file to .env and fill in the necessary values. Never commit .env.
# ==============================================================================

# Application Settings (Implemented)
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="ShopShield BD"
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# Security & CORS (Implemented)
SECRET_KEY=replace_with_a_secure_random_string_in_production
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]

# AI Extraction Engine — Google GenAI (Implemented & Unit-Tested)
# Obtain an API key from Google AI Studio (https://aistudio.google.com/)
# If unset, the backend runs in unconfigured mode and returns HTTP 503 for live /api/v1/analyze requests.
# Deterministic unit and integration tests run offline without requiring an active key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_REQUEST_TIMEOUT_SECONDS=30
MAX_INPUT_TEXT_LENGTH=15000

# ------------------------------------------------------------------------------
# Future / Planned Features (Roadmap — Not yet implemented)
# ------------------------------------------------------------------------------

# Screenshot OCR Upload Endpoint (Planned Task 03)
# OCR_STORAGE_DIR=./uploads/screenshots

# Courier Tracking Gateways (Planned Task 03 — Steadfast, Pathao, RedX)
COURIER_API_ENDPOINT=https://api.courier-sandbox.example.com
COURIER_API_KEY=

# Mobile Financial Services (MFS) Sandbox Verification (Planned Task 04)
MFS_VERIFICATION_ENABLED=false
BKASH_MERCHANT_QUERY_URL=

# Persistent Storage / Audit Database (Planned Future Phase)
DATABASE_URL=sqlite+aiosqlite:///./shopshield.db
